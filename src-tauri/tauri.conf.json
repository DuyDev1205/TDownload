{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidSaver",
  "version": "../package.json",
  "identifier": "com.msduyen.vidsaver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VidSaver",
        "width": 940,
        "height": 740,
        "minWidth": 600,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Tải video & MP3 từ YouTube, TikTok, Facebook",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NEQwQjEzMjZFNERGQTYKUldTbTMrUW1Fd3RONW5xYlhOSEFSdFFSeVZSdjVyUjdpRFhQR3lWSndpKzJmOEQ3L0NoNHlUa2MK",
      "endpoints": ["https://github.com/DuyDev1205/TDownload/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
